{
  "expo": {
    "name": "TasteRank",
    "slug": "tasterank",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "tasterank",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101318",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tasterank.app"
    },
    "android": {
      "package": "com.tasterank.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#101318",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101318",
          "image": "./assets/splash-icon.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TasteRank uses your photos to attach a picture to a rating.",
          "cameraPermission": "TasteRank uses your camera to attach a photo to a rating.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TasteRank uses your camera to scan product barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
